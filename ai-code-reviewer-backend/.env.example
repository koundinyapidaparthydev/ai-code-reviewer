# Environment
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://ai:ai@localhost:5432/ai_code_reviewer?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# OpenAI (leave empty to use the deterministic sandbox reviewer)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Reviewer: tools (default) or legacy dump-the-file prompt
REVIEW_MODE=tools

# Eval fixtures and last report
EVAL_FIXTURES_PATH=../fixtures/eval
EVAL_REPORT_PATH=./eval/last-report.json

# AWS S3 (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ai-code-validator

# Email (SendGrid/SMTP)
EMAIL_FROM=noreply@aivalidator.com
SENDGRID_API_KEY=your_sendgrid_api_key
# Or SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
VALIDATION_LIMIT_PER_HOUR=20

# File Upload
MAX_FILE_SIZE=1048576
MAX_FILES_PER_VALIDATION=20
UPLOAD_DIR=./uploads
